# brain-pxp: driver e opzioni aggiuntive per SHARP Brain PW-SH5
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=8
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BRAIN=y
CONFIG_SND_SOC_BU26154=y
CONFIG_SND_SOC_MXS_BRAIN=y
CONFIG_BRAIN_PXP=y
# swap compresso in RAM (piu veloce della microSD)
CONFIG_BLK_DEV=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
