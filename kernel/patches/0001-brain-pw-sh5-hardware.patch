+/*
+ * Hardware brought up for the PW-SH5 (Brain Hackers / brain-pxp work):
+ * Pixel Pipeline, RTC shared with Windows CE, battery reporting and the
+ * ROHM BU26154 audio codec found at i2c0 0x1a (the sgtl5000 node is an
+ * i.MX28 EVK leftover and is not populated on this board).
+ */
+
+/*
+ * USB as a device (NCM Ethernet gadget towards the PC), as set by
+ * "brain-config -> USB -> peripheral" on Brainux.
+ */
+&usb0 {
+	dr_mode = "peripheral";
+};
+
+&pxp {
+	compatible = "fsl,imx28-pxp";
+	status = "okay";
+};
+
+&mxs_rtc {
+	status = "okay";
+	/* Windows CE keeps JST (UTC+9) seconds since 2000-01-01 */
+	sharp,rtc-offset-seconds = <946652400>;
+	/* 32.768 kHz crystal, as Windows CE uses it: no clock source switch at boot */
+	stmp,crystal-freq = <32768>;
+};
+
+&power {
+	battery {
+		compatible = "sharp,brain-battery";
+		/* PSWITCH (power button), on the 5 V detectors' interrupt line */
+		interrupts = <6>;
+		io-channels = <&lradc 7>, <&lradc 8>, <&lradc 0>;
+		io-channel-names = "vbatt", "temp", "batt-temp";
+		voltage-min-design-microvolt = <3300000>;
+		voltage-max-design-microvolt = <4200000>;
+		/*
+		 * Li-ion charger run by the driver (the firmware leaves it
+		 * off). Values of SHARP's firmware for a USB port: 450 mA
+		 * with the 5 V input limited to 480 mA, stop under 50 mA.
+		 */
+		sharp,charge-current-microamp = <450000>;
+		sharp,precharge-current-microamp = <80000>;
+		sharp,term-current-microamp = <50000>;
+		sharp,input-current-limit-microamp = <480000>;
+		sharp,recharge-microvolt = <4000000>;
+		sharp,charge-timeout-seconds = <36000>;
+	};
+};
+
+&sgtl5000 {
+	status = "disabled";
+};
+
+&i2c0 {
+	bu26154: codec@1a {
+		compatible = "rohm,bu26154";
+		reg = <0x1a>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+/*
+ * Headphone jack switch: GPMI_RDN used as GPIO0_24, low when a plug is in
+ * (pin and polarity from the BU26154 wave driver of the Windows CE firmware).
+ */
+&pinctrl {
+	hp_det_pin: hp-det@0 {
+		reg = <0>;
+		fsl,pinmux-ids = <MX28_PAD_GPMI_RDN__GPIO_0_24>;
+		fsl,drive-strength = <MXS_DRIVE_4mA>;
+		fsl,voltage = <MXS_VOLTAGE_HIGH>;
+		fsl,pull-up = <MXS_PULL_ENABLE>;
+	};
+};
+
+/ {
+	sound {
+		compatible = "sharp,brain-audio-bu26154";
+		model = "Brain";
+		saif-controllers = <&saif0 &saif1>;
+		audio-codec = <&bu26154>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hp_det_pin>;
+		hp-det-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
+	};
+};
