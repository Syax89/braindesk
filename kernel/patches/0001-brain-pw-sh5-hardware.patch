+int brain_lcd_scanout_get(struct brain_lcd_scanout *so)
+{
+	struct brain_drm_private *ili = brain_lcd;
+	struct drm_framebuffer *fb = NULL;
+	struct drm_plane *plane;
+
+	if (!ili)
+		return -ENODEV;
+	plane = &ili->pipe.plane;
+
+	drm_modeset_lock(&plane->mutex, NULL);
+	if (plane->state && plane->state->fb && ili->enabled) {
+		fb = plane->state->fb;
+		drm_framebuffer_get(fb);
+	}
+	drm_modeset_unlock(&plane->mutex);
+	if (!fb)
+		return -ENODEV;
+	if (fb->format->format != DRM_FORMAT_RGB565) {
+		drm_framebuffer_put(fb);
+		return -EINVAL;
+	}
+
+	so->dma = drm_fb_dma_get_gem_obj(fb, 0)->dma_addr + fb->offsets[0];
+	so->width = fb->width;
+	so->height = fb->height;
+	so->pitch = fb->pitches[0];
+	so->fb = fb;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(brain_lcd_scanout_get);
