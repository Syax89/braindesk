diff --git a/drivers/power/supply/brain_battery.c b/drivers/power/supply/brain_battery.c
new file mode 100644
index 000000000..34a7418e8
--- /dev/null
+++ b/drivers/power/supply/brain_battery.c
@@ -0,0 +1,993 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Battery, USB power and battery charger for SHARP Brain (i.MX28)
+ *
+ * The battery voltage is measured live through LRADC channel 7 (IIO);
+ * external power comes from HW_POWER_STS of the i.MX28 power block (a
+ * syscon).
+ *
+ * The i.MX28 has a linear Li-ion charger (5 V -> battery, constant current
+ * then constant 4.2 V in hardware) but no charge controller: the boot
+ * firmware leaves it powered down and the running OS must start it, decide
+ * when the battery is full and stop it. Windows CE does that on the Brain;
+ * without it the battery never charges under Linux.
+ *
+ * The state machine and every default below reproduce what SHARP's own
+ * firmware does (pmuPdk.dll / battdrvr.dll, see ref/wince/charger-notes.md):
+ *   - pre-charge at 80 mA under 3.0 V, for 30 minutes at most
+ *   - constant current (450 mA from a USB port, with the 5 V input limited
+ *     to 480 mA so the port is never overloaded: the system has priority
+ *     and the battery gets what is left)
+ *   - full when the charge current stays under 50 mA with the cell at
+ *     4.13 V or more for five minutes; recharge under 4.0 V
+ *   - battery thermistor (LRADC channel 0 fed by the on-chip 140 uA source)
+ *     must read between -5 and 45 degrees C
+ *   - die over 100 degrees C: 100 mA; over 110: stop
+ *   - safety timeout
+ * On battery, a cell under 3.3 V powers the system off like the original
+ * firmware does.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/iio/consumer.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/reboot.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define HW_POWER_CTRL			0x00
+#define  CTRL_ENIRQ_VBUS_VALID		BIT(3)
+#define  CTRL_VBUSVALID_IRQ		BIT(4)
+#define  CTRL_POLARITY_VBUSVALID	BIT(5)
+#define  CTRL_ENIRQ_PSWITCH		BIT(17)
+#define  CTRL_POLARITY_PSWITCH		BIT(18)
+#define  CTRL_PSWITCH_IRQ		BIT(20)
+#define HW_POWER_5VCTRL			0x10
+#define  CTRL5V_CHARGE_4P2_ILIMIT	GENMASK(17, 12)
+#define  CTRL5V_PWD_CHARGE_4P2		GENMASK(21, 20)
+#define HW_POWER_CHARGE			0x30
+#define  CHARGE_BATTCHRG_I		GENMASK(5, 0)
+#define  CHARGE_STOP_ILIMIT		GENMASK(11, 8)
+#define  CHARGE_PWD_BATTCHRG		BIT(16)
+#define HW_POWER_STS			0xc0
+#define  STS_VBUSVALID0			BIT(1)
+#define  STS_VDD5V_GT_VDDIO		BIT(5)
+#define  STS_CHRGSTS			BIT(11)
+#define  STS_BATT_BO			BIT(13)
+#define  STS_PSWITCH			GENMASK(21, 20)
+
+#define REG_SET				0x4
+#define REG_CLR				0x8
+
+/* LRADC: current source for the battery thermistor on channel 0 */
+#define HW_LRADC_CTRL2			0x20
+#define  CTRL2_TEMP_ISRC0_140UA		0x7
+#define  CTRL2_TEMP_ISRC0		GENMASK(3, 0)
+#define  CTRL2_TEMP_SENSOR_IENABLE0	BIT(8)
+
+/* thermistor readings (ADC counts): higher = colder */
+#define NTC_NO_BATTERY			3072
+#define NTC_COLD			2557	/* -5 C */
+#define NTC_HOT				1561	/* 45 C */
+
+#define DIE_WARM_C			100	/* charge at 100 mA above this */
+#define DIE_HOT_C			110	/* stop above this */
+#define DIE_SAFE_MA			100
+
+#define FULL_MV				4130
+#define POWEROFF_MV			3300
+
+#define POLL_IDLE			(30 * HZ)
+#define POLL_CHARGING			(2 * HZ)
+
+/* charge current steps of 50 mA every poll: a gentle ramp for the 5 V rail */
+#define RAMP_STEP_MA			50
+/* full: current under the threshold for 5 minutes (150 polls of 2 s) */
+#define TERM_POLLS			150
+/* ignore CHRGSTS for a while after (re)starting: the comparator needs time */
+#define SETTLE_POLLS			15
+/* thermistor check every minute */
+#define NTC_POLLS			30
+/* on battery: this many low readings in a row (30 s apart) power off */
+#define LOW_POLLS			3
+
+enum brain_chg_state {
+	CHG_OFF,	/* no external power */
+	CHG_PRECHARGE,	/* deeply discharged cell: small current */
+	CHG_FAST,	/* constant current / constant voltage */
+	CHG_DONE,	/* full, charger off, waiting for the cell to sag */
+	CHG_TEMP,	/* paused: battery too cold or too warm */
+	CHG_FAULT,	/* stopped until power is replugged */
+};
+
+struct brain_battery {
+	struct device *dev;
+	struct regmap *power;
+	struct iio_channel *vbatt;
+	struct iio_channel *temp;	/* optional: die temperature */
+	struct iio_channel *ntc;	/* optional: battery thermistor */
+	void __iomem *lradc;		/* for the thermistor current source */
+	struct power_supply *bat;
+	struct power_supply *usb;
+	struct delayed_work work;
+	struct notifier_block reboot_nb;
+	struct input_dev *pwrkey;	/* the power switch (PSWITCH) */
+	int pwrkey_irq;
+	struct mutex lock;		/* charger state and registers */
+	int vmin_uv, vmax_uv;
+
+	/* configuration (mA, mV, seconds) */
+	u32 charge_ma;
+	u32 precharge_ma;
+	u32 term_ma;
+	u32 input_ma;
+	u32 precharge_mv;
+	u32 recharge_mv;
+	u32 precharge_timeout_s;
+	u32 timeout_s;
+	u32 resistance_mohm;
+	bool charger_enabled;
+
+	/* state */
+	enum brain_chg_state state;
+	u32 cur_ma;			/* programmed right now */
+	unsigned int polls;		/* since the charge current was started */
+	unsigned int low_polls;		/* consecutive polls with CHRGSTS low */
+	unsigned int ntc_polls;		/* since the last thermistor reading */
+	unsigned int empty_polls;	/* consecutive low readings on battery */
+	unsigned long started;		/* jiffies: start of this charge cycle */
+	int ntc_adc;			/* last thermistor reading, 0 = none */
+	bool ext_power;
+};
+
+/* Li-ion open circuit voltage (mV) to state of charge (%) */
+static const struct { int mv, pct; } ocv_table[] = {
+	{ 4180, 100 }, { 4100, 92 }, { 4000, 82 }, { 3920, 72 },
+	{ 3850, 60 }, { 3800, 50 }, { 3760, 40 }, { 3730, 30 },
+	{ 3700, 20 }, { 3650, 10 }, { 3550, 5 }, { 3400, 2 }, { 3300, 0 },
+};
+
+static int ocv_to_capacity(int mv)
+{
+	int i;
+
+	if (mv >= ocv_table[0].mv)
+		return 100;
+	for (i = 1; i < ARRAY_SIZE(ocv_table); i++) {
+		if (mv >= ocv_table[i].mv) {
+			int dmv = ocv_table[i - 1].mv - ocv_table[i].mv;
+			int dp = ocv_table[i - 1].pct - ocv_table[i].pct;
+
+			return ocv_table[i].pct +
+			       (mv - ocv_table[i].mv) * dp / dmv;
+		}
+	}
+	return 0;
+}
+
+static int brain_vbatt_mv(struct brain_battery *bb, int *mv)
+{
+	int ret = iio_read_channel_processed(bb->vbatt, mv);
+
+	return ret < 0 ? ret : 0;
+}
+
+static u32 brain_sts(struct brain_battery *bb)
+{
+	u32 sts = 0;
+
+	regmap_read(bb->power, HW_POWER_STS, &sts);
+	return sts;
+}
+
+static bool sts_ext_power(u32 sts)
+{
+	return sts & (STS_VDD5V_GT_VDDIO | STS_VBUSVALID0);
+}
+
+/* BATTCHRG_I / CHARGE_4P2_ILIMIT bit weights: 10, 20, 50, 100, 200, 400 mA */
+static u32 ma_to_ilimit(u32 ma)
+{
+	static const u16 w[] = { 400, 200, 100, 50, 20, 10 };
+	u32 bits = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(w); i++) {
+		if (ma >= w[i]) {
+			ma -= w[i];
+			bits |= BIT(5 - i);
+		}
+	}
+	return bits;
+}
+
+/* STOP_ILIMIT bit weights: 10, 20, 50, 100 mA */
+static u32 ma_to_stop(u32 ma)
+{
+	static const u16 w[] = { 100, 50, 20, 10 };
+	u32 bits = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(w); i++) {
+		if (ma >= w[i]) {
+			ma -= w[i];
+			bits |= BIT(3 - i);
+		}
+	}
+	return bits;
+}
+
+/* program the charger; 0 mA powers it down */
+static void brain_chg_set_current(struct brain_battery *bb, u32 ma)
+{
+	if (!ma) {
+		regmap_write(bb->power, HW_POWER_CHARGE + REG_SET,
+			     CHARGE_PWD_BATTCHRG);
+		regmap_write(bb->power, HW_POWER_CHARGE + REG_CLR,
+			     CHARGE_BATTCHRG_I);
+		/* charger off: the system may use all the 5 V input again */
+		regmap_write(bb->power, HW_POWER_5VCTRL + REG_SET,
+			     CTRL5V_CHARGE_4P2_ILIMIT);
+	} else {
+		/* the 4.2 V rail feeding system and charger must be powered */
+		regmap_write(bb->power, HW_POWER_5VCTRL + REG_CLR,
+			     CTRL5V_PWD_CHARGE_4P2);
+		if (!bb->cur_ma && bb->input_ma)
+			regmap_update_bits(bb->power, HW_POWER_5VCTRL,
+					   CTRL5V_CHARGE_4P2_ILIMIT,
+					   FIELD_PREP(CTRL5V_CHARGE_4P2_ILIMIT,
+						      ma_to_ilimit(bb->input_ma)));
+		regmap_update_bits(bb->power, HW_POWER_CHARGE,
+				   CHARGE_BATTCHRG_I | CHARGE_STOP_ILIMIT,
+				   FIELD_PREP(CHARGE_BATTCHRG_I,
+					      ma_to_ilimit(ma)) |
+				   FIELD_PREP(CHARGE_STOP_ILIMIT,
+					      ma_to_stop(bb->term_ma)));
+		regmap_write(bb->power, HW_POWER_CHARGE + REG_CLR,
+			     CHARGE_PWD_BATTCHRG);
+	}
+	if (ma != bb->cur_ma && (!ma || !bb->cur_ma))
+		bb->polls = 0;
+	bb->cur_ma = ma;
+}
+
+static void brain_chg_enter(struct brain_battery *bb, enum brain_chg_state st)
+{
+	static const char * const names[] = {
+		"off", "precharge", "fast", "done", "temperature", "fault",
+	};
+
+	if (st == bb->state)
+		return;
+	dev_info(bb->dev, "charger: %s -> %s\n", names[bb->state], names[st]);
+	bb->state = st;
+	bb->low_polls = 0;
+	if (st != CHG_PRECHARGE && st != CHG_FAST)
+		brain_chg_set_current(bb, 0);
+}
+
+/* battery voltage with the charge current's IR rise removed (mV) */
+static int brain_ocv_mv(struct brain_battery *bb, int mv)
+{
+	return mv - (int)(bb->cur_ma * bb->resistance_mohm / 1000);
+}
+
+/* battery thermistor: switch its current source on, read, switch off */
+static void brain_read_ntc(struct brain_battery *bb)
+{
+	int i, raw, sum = 0;
+
+	if (!bb->ntc || !bb->lradc)
+		return;
+	writel(CTRL2_TEMP_ISRC0, bb->lradc + HW_LRADC_CTRL2 + REG_CLR);
+	writel(CTRL2_TEMP_ISRC0_140UA | CTRL2_TEMP_SENSOR_IENABLE0,
+	       bb->lradc + HW_LRADC_CTRL2 + REG_SET);
+	msleep(10);
+	for (i = 0; i < 5; i++) {
+		if (iio_read_channel_raw(bb->ntc, &raw) < 0) {
+			sum = 0;
+			break;
+		}
+		sum += raw;
+	}
+	writel(CTRL2_TEMP_ISRC0 | CTRL2_TEMP_SENSOR_IENABLE0,
+	       bb->lradc + HW_LRADC_CTRL2 + REG_CLR);
+	bb->ntc_adc = sum / 5;
+	bb->ntc_polls = 0;
+}
+
+/* thermistor ADC counts for -25..60 C in steps of 5 (SHARP's table) */
+static const u16 ntc_table[] = {
+	2883, 2811, 2729, 2637, 2538, 2433, 2324, 2213, 2103,
+	1997, 1895, 1801, 1713, 1633, 1561, 1497, 1439, 1388,
+};
+
+/* tenths of a degree C */
+static int ntc_to_temp(int adc)
+{
+	int i;
+
+	if (adc >= ntc_table[0])
+		return -250;
+	for (i = 1; i < ARRAY_SIZE(ntc_table); i++)
+		if (adc >= ntc_table[i])
+			return -250 + i * 50 -
+			       (adc - ntc_table[i]) * 50 /
+			       (ntc_table[i - 1] - ntc_table[i]);
+	return 600;
+}
+
+static bool brain_ntc_ok(struct brain_battery *bb)
+{
+	if (!bb->ntc)
+		return true;		/* board without a thermistor */
+	/* a failed reading (0) is not a temperature: do not charge */
+	return bb->ntc_adc >= NTC_HOT && bb->ntc_adc <= NTC_COLD;
+}
+
+static void brain_chg_step(struct brain_battery *bb, u32 sts)
+{
+	bool ext = sts & STS_VBUSVALID0;
+	int mv = 0, die = 0;
+	u32 target;
+
+	if (!bb->charger_enabled || !ext) {
+		brain_chg_enter(bb, CHG_OFF);
+		return;
+	}
+	if (brain_vbatt_mv(bb, &mv)) {
+		/* blind: never charge without knowing the cell voltage */
+		brain_chg_enter(bb, CHG_OFF);
+		return;
+	}
+	if (bb->temp)
+		iio_read_channel_processed(bb->temp, &die);
+	if (bb->state == CHG_OFF || ++bb->ntc_polls >= NTC_POLLS)
+		brain_read_ntc(bb);
+	if (bb->ntc_adc > NTC_NO_BATTERY) {
+		brain_chg_enter(bb, CHG_OFF);	/* no battery fitted */
+		return;
+	}
+
+	switch (bb->state) {
+	case CHG_OFF:
+		bb->started = jiffies;
+		if (mv > FULL_MV)
+			brain_chg_enter(bb, CHG_DONE);
+		else if (!brain_ntc_ok(bb))
+			brain_chg_enter(bb, CHG_TEMP);
+		else if (mv < (int)bb->precharge_mv)
+			brain_chg_enter(bb, CHG_PRECHARGE);
+		else
+			brain_chg_enter(bb, CHG_FAST);
+		return;
+	case CHG_DONE:
+		if (mv < (int)bb->recharge_mv && brain_ntc_ok(bb)) {
+			bb->started = jiffies;
+			brain_chg_enter(bb, CHG_FAST);
+		}
+		return;
+	case CHG_FAULT:
+		return;		/* until external power goes away */
+	case CHG_TEMP:
+		if (brain_ntc_ok(bb)) {
+			bb->started = jiffies;
+			brain_chg_enter(bb, mv < (int)bb->precharge_mv ?
+					CHG_PRECHARGE : CHG_FAST);
+		}
+		return;
+	default:
+		break;
+	}
+
+	/* PRECHARGE, FAST: the charger is (about to be) running */
+	if (!brain_ntc_ok(bb)) {
+		brain_chg_enter(bb, CHG_TEMP);
+		return;
+	}
+	if (bb->temp && die > DIE_HOT_C) {
+		dev_warn(bb->dev, "die at %d C, charger stopped\n", die);
+		brain_chg_enter(bb, CHG_FAULT);
+		return;
+	}
+	if (bb->state == CHG_PRECHARGE &&
+	    time_after(jiffies, bb->started + bb->precharge_timeout_s * HZ)) {
+		dev_warn(bb->dev, "battery does not recover, charger stopped\n");
+		brain_chg_enter(bb, CHG_FAULT);
+		return;
+	}
+	if (time_after(jiffies, bb->started + bb->timeout_s * HZ)) {
+		if (mv >= 4100) {
+			brain_chg_enter(bb, CHG_DONE);
+		} else {
+			dev_warn(bb->dev, "charge timeout, charger stopped\n");
+			brain_chg_enter(bb, CHG_FAULT);
+		}
+		return;
+	}
+
+	if (bb->state == CHG_PRECHARGE && mv >= (int)bb->precharge_mv + 50)
+		brain_chg_enter(bb, CHG_FAST);
+
+	target = bb->state == CHG_PRECHARGE ? bb->precharge_ma : bb->charge_ma;
+	if (bb->temp && die > DIE_WARM_C)
+		target = min_t(u32, target, DIE_SAFE_MA);
+	if (bb->cur_ma < target)
+		brain_chg_set_current(bb, min(target,
+					      bb->cur_ma + RAMP_STEP_MA));
+	else if (bb->cur_ma > target)
+		brain_chg_set_current(bb, target);
+	bb->polls++;
+
+	if (bb->cur_ma < target || bb->polls < SETTLE_POLLS)
+		return;
+
+	/*
+	 * CHRGSTS low = charge current under STOP_ILIMIT. With the cell at
+	 * its final voltage that means full; at a lower voltage it only
+	 * means the 5 V input limit is leaving little for the battery.
+	 */
+	if (!(sts & STS_CHRGSTS) && mv >= FULL_MV)
+		bb->low_polls++;
+	else
+		bb->low_polls = 0;
+
+	if (bb->state == CHG_FAST && bb->low_polls >= TERM_POLLS)
+		brain_chg_enter(bb, CHG_DONE);
+}
+
+static bool brain_chg_active(struct brain_battery *bb)
+{
+	return bb->state == CHG_PRECHARGE || bb->state == CHG_FAST;
+}
+
+static int brain_bat_get(struct power_supply *psy,
+			 enum power_supply_property psp,
+			 union power_supply_propval *val)
+{
+	struct brain_battery *bb = power_supply_get_drvdata(psy);
+	u32 sts = brain_sts(bb);
+	int mv, ret = 0;
+
+	mutex_lock(&bb->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (brain_chg_active(bb))
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (bb->state == CHG_DONE)
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		else if (sts_ext_power(sts))
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		if (bb->state == CHG_PRECHARGE)
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_TRICKLE;
+		else if (bb->state == CHG_FAST)
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_FAST;
+		else
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (sts & STS_BATT_BO)
+			val->intval = POWER_SUPPLY_HEALTH_DEAD;
+		else if (bb->state == CHG_TEMP)
+			val->intval = bb->ntc_adc > NTC_COLD ?
+				      POWER_SUPPLY_HEALTH_COLD :
+				      POWER_SUPPLY_HEALTH_OVERHEAT;
+		else if (bb->state == CHG_FAULT)
+			val->intval = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = brain_vbatt_mv(bb, &mv);
+		val->intval = mv * 1000;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		ret = brain_vbatt_mv(bb, &mv);
+		val->intval = brain_ocv_mv(bb, mv) * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = brain_vbatt_mv(bb, &mv);
+		if (ret)
+			break;
+		if (bb->state == CHG_DONE)
+			val->intval = 100;
+		else
+			val->intval = min(ocv_to_capacity(brain_ocv_mv(bb, mv)),
+					  brain_chg_active(bb) ? 99 : 100);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		val->intval = bb->cur_ma * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		val->intval = bb->charge_ma * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		val->intval = bb->charger_enabled ?
+			      POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
+			      POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		/* battery thermistor, tenths of a degree */
+		if (!bb->ntc_adc || bb->ntc_adc > NTC_NO_BATTERY)
+			ret = -ENODATA;
+		else
+			val->intval = ntc_to_temp(bb->ntc_adc);
+		break;
+	case POWER_SUPPLY_PROP_TEMP_AMBIENT:
+		/* SoC die (where the charger sits), tenths of a degree */
+		if (!bb->temp) {
+			ret = -ENODATA;
+			break;
+		}
+		ret = iio_read_channel_processed(bb->temp, &mv);
+		val->intval = mv * 10;
+		if (ret > 0)
+			ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = bb->vmin_uv;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = bb->vmax_uv;
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&bb->lock);
+	return ret;
+}
+
+static int brain_bat_set(struct power_supply *psy,
+			 enum power_supply_property psp,
+			 const union power_supply_propval *val)
+{
+	struct brain_battery *bb = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	mutex_lock(&bb->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		/* 780 mA is the most the charger can do */
+		if (val->intval < 10000 || val->intval > 780000)
+			ret = -EINVAL;
+		else
+			bb->charge_ma = val->intval / 1000;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		if (val->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO)
+			bb->charger_enabled = true;
+		else if (val->intval ==
+			 POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+			bb->charger_enabled = false;
+		else
+			ret = -EINVAL;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&bb->lock);
+	if (!ret)
+		mod_delayed_work(system_wq, &bb->work, 0);
+	return ret;
+}
+
+static int brain_bat_writeable(struct power_supply *psy,
+			       enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+}
+
+static int brain_usb_get(struct power_supply *psy,
+			 enum power_supply_property psp,
+			 union power_supply_propval *val)
+{
+	struct brain_battery *bb = power_supply_get_drvdata(psy);
+
+	if (psp != POWER_SUPPLY_PROP_ONLINE)
+		return -EINVAL;
+	val->intval = sts_ext_power(brain_sts(bb));
+	return 0;
+}
+
+static enum power_supply_property brain_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_TEMP_AMBIENT,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_SCOPE,
+};
+
+static enum power_supply_property brain_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+};
+
+static const struct power_supply_desc brain_bat_desc = {
+	.name		= "brain-battery",
+	.type		= POWER_SUPPLY_TYPE_BATTERY,
+	.properties	= brain_bat_props,
+	.num_properties	= ARRAY_SIZE(brain_bat_props),
+	.get_property	= brain_bat_get,
+	.set_property	= brain_bat_set,
+	.property_is_writeable = brain_bat_writeable,
+};
+
+static const struct power_supply_desc brain_usb_desc = {
+	.name		= "brain-usb",
+	.type		= POWER_SUPPLY_TYPE_USB,
+	.properties	= brain_usb_props,
+	.num_properties	= ARRAY_SIZE(brain_usb_props),
+	.get_property	= brain_usb_get,
+};
+
+static char *brain_usb_supplied_to[] = { "brain-battery" };
+
+/* the power block has no interrupt wired here: poll for changes */
+static void brain_battery_work(struct work_struct *work)
+{
+	struct brain_battery *bb = container_of(to_delayed_work(work),
+						struct brain_battery, work);
+	u32 sts = brain_sts(bb);
+	enum brain_chg_state old;
+	bool ext = sts_ext_power(sts), active;
+
+	mutex_lock(&bb->lock);
+	old = bb->state;
+	brain_chg_step(bb, sts);
+	active = brain_chg_active(bb);
+	if (!ext) {
+		int mv;
+
+		/* refresh the temperature shown to userspace now and then */
+		if (++bb->ntc_polls >= 2)
+			brain_read_ntc(bb);
+		/* an empty cell must not be drained further */
+		if (!brain_vbatt_mv(bb, &mv) && mv > 2000 && mv < POWEROFF_MV)
+			bb->empty_polls++;
+		else
+			bb->empty_polls = 0;
+		if (bb->empty_polls == LOW_POLLS) {
+			dev_emerg(bb->dev, "battery empty (%d mV): power off\n",
+				  mv);
+			orderly_poweroff(true);
+		}
+	} else {
+		bb->empty_polls = 0;
+	}
+	if (ext != bb->ext_power) {
+		bb->ext_power = ext;
+		power_supply_changed(bb->usb);
+	}
+	mutex_unlock(&bb->lock);
+
+	/* on battery the capacity drifts: tell userspace every poll (30 s) */
+	if (old != bb->state || !ext)
+		power_supply_changed(bb->bat);
+
+	/* poll fast with external power so plugging/unplugging is noticed */
+	schedule_delayed_work(&bb->work, ext ? POLL_CHARGING : POLL_IDLE);
+}
+
+/* never leave the charger running without its state machine */
+static int brain_battery_reboot(struct notifier_block *nb,
+				unsigned long action, void *data)
+{
+	struct brain_battery *bb = container_of(nb, struct brain_battery,
+						reboot_nb);
+
+	cancel_delayed_work_sync(&bb->work);
+	mutex_lock(&bb->lock);
+	brain_chg_set_current(bb, 0);
+	mutex_unlock(&bb->lock);
+	return NOTIFY_DONE;
+}
+
+/*
+ * Power switch. The i.MX28 PSWITCH pin latches PSWITCH_IRQ in HW_POWER_CTRL
+ * and raises interrupt 6 (shared with the 5 V detectors, which nothing here
+ * enables). POLARITY selects the edge: wait for the press, then for the
+ * release, so userspace gets a normal KEY_POWER down/up pair. It is also
+ * the wake-up source for suspend: the keyboard is polled and cannot wake.
+ */
+static irqreturn_t brain_pwrkey_irq(int irq, void *data)
+{
+	struct brain_battery *bb = data;
+	u32 ctrl = 0, sts;
+	bool pressed;
+
+	regmap_read(bb->power, HW_POWER_CTRL, &ctrl);
+
+	/*
+	 * USB plugged or unplugged: flip the polarity to wait for the other
+	 * edge and run the charger state machine now (this also wakes the
+	 * system from suspend, so plugging in starts charging at once).
+	 */
+	if (ctrl & CTRL_VBUSVALID_IRQ) {
+		regmap_write(bb->power, HW_POWER_CTRL +
+			     ((ctrl & CTRL_POLARITY_VBUSVALID) ? REG_CLR : REG_SET),
+			     CTRL_POLARITY_VBUSVALID);
+		regmap_write(bb->power, HW_POWER_CTRL + REG_CLR,
+			     CTRL_VBUSVALID_IRQ);
+		mod_delayed_work(system_wq, &bb->work, HZ / 2);
+		pm_wakeup_event(bb->dev, 0);
+		if (!(ctrl & CTRL_PSWITCH_IRQ))
+			return IRQ_HANDLED;
+	}
+	if (!(ctrl & CTRL_PSWITCH_IRQ))
+		return IRQ_NONE;
+
+	pressed = !(ctrl & CTRL_POLARITY_PSWITCH);
+	/* now wait for the opposite edge */
+	regmap_write(bb->power, HW_POWER_CTRL + (pressed ? REG_SET : REG_CLR),
+		     CTRL_POLARITY_PSWITCH);
+	regmap_write(bb->power, HW_POWER_CTRL + REG_CLR, CTRL_PSWITCH_IRQ);
+
+	/* a press shorter than the interrupt latency: report both edges */
+	sts = brain_sts(bb);
+	input_report_key(bb->pwrkey, KEY_POWER, 1);
+	input_sync(bb->pwrkey);
+	if (!pressed || !(sts & STS_PSWITCH)) {
+		input_report_key(bb->pwrkey, KEY_POWER, 0);
+		input_sync(bb->pwrkey);
+		if (pressed)	/* already released: back to waiting for a press */
+			regmap_write(bb->power, HW_POWER_CTRL + REG_CLR,
+				     CTRL_POLARITY_PSWITCH);
+	}
+	pm_wakeup_event(bb->dev, 0);
+	return IRQ_HANDLED;
+}
+
+static int brain_pwrkey_init(struct brain_battery *bb)
+{
+	struct device *dev = bb->dev;
+	int irq, ret;
+
+	irq = of_irq_get(dev->of_node, 0);
+	if (irq <= 0)
+		return irq == -EPROBE_DEFER ? irq : 0;	/* no power key */
+
+	bb->pwrkey = devm_input_allocate_device(dev);
+	if (!bb->pwrkey)
+		return -ENOMEM;
+	bb->pwrkey->name = "Brain Power Button";
+	bb->pwrkey->phys = "brain-pswitch/input0";
+	input_set_capability(bb->pwrkey, EV_KEY, KEY_POWER);
+	ret = input_register_device(bb->pwrkey);
+	if (ret)
+		return ret;
+
+	/* start waiting for a press, with any stale latch cleared */
+	regmap_write(bb->power, HW_POWER_CTRL + REG_CLR,
+		     CTRL_PSWITCH_IRQ | CTRL_POLARITY_PSWITCH);
+	ret = devm_request_threaded_irq(dev, irq, NULL, brain_pwrkey_irq,
+					IRQF_ONESHOT | IRQF_SHARED,
+					"brain-pswitch", bb);
+	if (ret)
+		return ret;
+	/* VBUSVALID: interrupt on the edge away from the current state */
+	regmap_write(bb->power, HW_POWER_CTRL +
+		     ((brain_sts(bb) & STS_VBUSVALID0) ? REG_CLR : REG_SET),
+		     CTRL_POLARITY_VBUSVALID);
+	regmap_write(bb->power, HW_POWER_CTRL + REG_CLR, CTRL_VBUSVALID_IRQ);
+	regmap_write(bb->power, HW_POWER_CTRL + REG_SET,
+		     CTRL_ENIRQ_PSWITCH | CTRL_ENIRQ_VBUS_VALID);
+	bb->pwrkey_irq = irq;
+	device_init_wakeup(dev, true);
+	return 0;
+}
+
+static int brain_battery_suspend(struct device *dev)
+{
+	struct brain_battery *bb = dev_get_drvdata(dev);
+
+	if (bb->pwrkey_irq && device_may_wakeup(dev))
+		enable_irq_wake(bb->pwrkey_irq);
+	return 0;
+}
+
+static int brain_battery_resume(struct device *dev)
+{
+	struct brain_battery *bb = dev_get_drvdata(dev);
+
+	if (bb->pwrkey_irq && device_may_wakeup(dev))
+		disable_irq_wake(bb->pwrkey_irq);
+	/* the cell may have changed a lot while asleep */
+	mod_delayed_work(system_wq, &bb->work, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(brain_battery_pm, brain_battery_suspend,
+				brain_battery_resume);
+
+static int brain_battery_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct power_supply_config cfg = {};
+	struct brain_battery *bb;
+	u32 ua;
+	int ret;
+
+	bb = devm_kzalloc(dev, sizeof(*bb), GFP_KERNEL);
+	if (!bb)
+		return -ENOMEM;
+	bb->dev = dev;
+	mutex_init(&bb->lock);
+
+	bb->power = syscon_node_to_regmap(dev->parent->of_node);
+	if (IS_ERR(bb->power))
+		return dev_err_probe(dev, PTR_ERR(bb->power),
+				     "no power block regmap\n");
+
+	bb->vbatt = devm_iio_channel_get(dev, "vbatt");
+	if (IS_ERR(bb->vbatt))
+		return dev_err_probe(dev, PTR_ERR(bb->vbatt),
+				     "no battery voltage channel\n");
+
+	bb->temp = devm_iio_channel_get(dev, "temp");
+	if (IS_ERR(bb->temp)) {
+		if (PTR_ERR(bb->temp) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		bb->temp = NULL;
+	}
+
+	bb->ntc = devm_iio_channel_get(dev, "batt-temp");
+	if (IS_ERR(bb->ntc)) {
+		if (PTR_ERR(bb->ntc) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		bb->ntc = NULL;
+	} else {
+		/* the thermistor's current source is an LRADC register */
+		struct device_node *lradc = of_parse_phandle(np, "io-channels",
+							     0);
+
+		struct resource res;
+
+		/*
+		 * Plain ioremap: the region already belongs to the LRADC
+		 * drivers, only the atomic SET/CLR registers are used here.
+		 */
+		if (lradc && !of_address_to_resource(lradc, 0, &res))
+			bb->lradc = devm_ioremap(dev, res.start,
+						 resource_size(&res));
+		of_node_put(lradc);
+		if (!bb->lradc)
+			return dev_err_probe(dev, -ENOMEM,
+					     "cannot map the thermistor source\n");
+	}
+
+	bb->vmin_uv = 3300000;
+	bb->vmax_uv = 4200000;
+	of_property_read_u32(np, "voltage-min-design-microvolt", &bb->vmin_uv);
+	of_property_read_u32(np, "voltage-max-design-microvolt", &bb->vmax_uv);
+
+	/* charger defaults; see the device tree for the values in use */
+	bb->charge_ma = 450;
+	bb->precharge_ma = 80;
+	bb->term_ma = 50;
+	bb->input_ma = 480;		/* 0: keep the firmware's 5 V limit */
+	bb->precharge_mv = 3000;
+	bb->recharge_mv = 4000;
+	bb->precharge_timeout_s = 30 * 60;
+	bb->timeout_s = 10 * 3600;
+	bb->resistance_mohm = 250;
+	bb->charger_enabled = !of_property_read_bool(np, "sharp,no-charger");
+	if (!of_property_read_u32(np, "sharp,charge-current-microamp", &ua))
+		bb->charge_ma = ua / 1000;
+	if (!of_property_read_u32(np, "sharp,precharge-current-microamp", &ua))
+		bb->precharge_ma = ua / 1000;
+	if (!of_property_read_u32(np, "sharp,term-current-microamp", &ua))
+		bb->term_ma = ua / 1000;
+	if (!of_property_read_u32(np, "sharp,input-current-limit-microamp",
+				  &ua))
+		bb->input_ma = ua / 1000;
+	if (!of_property_read_u32(np, "sharp,recharge-microvolt", &ua))
+		bb->recharge_mv = ua / 1000;
+	of_property_read_u32(np, "sharp,charge-timeout-seconds",
+			     &bb->timeout_s);
+	of_property_read_u32(np, "sharp,battery-resistance-milliohm",
+			     &bb->resistance_mohm);
+	bb->charge_ma = clamp(bb->charge_ma, 10u, 780u);
+	bb->precharge_ma = clamp(bb->precharge_ma, 10u, bb->charge_ma);
+	bb->term_ma = clamp(bb->term_ma, 10u, 180u);
+
+	/* start from a known state: charger off until the first poll */
+	brain_chg_set_current(bb, 0);
+
+	cfg.drv_data = bb;
+	cfg.of_node = np;
+	bb->bat = devm_power_supply_register(dev, &brain_bat_desc, &cfg);
+	if (IS_ERR(bb->bat))
+		return PTR_ERR(bb->bat);
+
+	cfg.of_node = NULL;
+	cfg.supplied_to = brain_usb_supplied_to;
+	cfg.num_supplicants = ARRAY_SIZE(brain_usb_supplied_to);
+	bb->usb = devm_power_supply_register(dev, &brain_usb_desc, &cfg);
+	if (IS_ERR(bb->usb))
+		return PTR_ERR(bb->usb);
+
+	bb->reboot_nb.notifier_call = brain_battery_reboot;
+	ret = devm_register_reboot_notifier(dev, &bb->reboot_nb);
+	if (ret)
+		return ret;
+
+	bb->ext_power = sts_ext_power(brain_sts(bb));
+	INIT_DELAYED_WORK(&bb->work, brain_battery_work);
+	platform_set_drvdata(pdev, bb);
+	ret = brain_pwrkey_init(bb);
+	if (ret)
+		dev_warn(dev, "power key unavailable: %d\n", ret);
+	schedule_delayed_work(&bb->work, HZ);
+	dev_info(dev, "charger %s: %u mA (5 V input %u mA), stop under %u mA%s\n",
+		 bb->charger_enabled ? "on" : "off", bb->charge_ma,
+		 bb->input_ma, bb->term_ma,
+		 bb->ntc ? ", battery thermistor" : "");
+	return 0;
+}
+
+static int brain_battery_remove(struct platform_device *pdev)
+{
+	struct brain_battery *bb = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&bb->work);
+	mutex_lock(&bb->lock);
+	brain_chg_set_current(bb, 0);
+	mutex_unlock(&bb->lock);
+	return 0;
+}
+
+static const struct of_device_id brain_battery_of_match[] = {
+	{ .compatible = "sharp,brain-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, brain_battery_of_match);
+
+static struct platform_driver brain_battery_driver = {
+	.probe	= brain_battery_probe,
+	.remove	= brain_battery_remove,
+	.driver	= {
+		.name = "brain-battery",
+		.of_match_table = brain_battery_of_match,
+		.pm = pm_sleep_ptr(&brain_battery_pm),
+	},
+};
+module_platform_driver(brain_battery_driver);
+
+MODULE_DESCRIPTION("SHARP Brain battery, USB power and charger");
+MODULE_LICENSE("GPL");
