diff --git a/sound/soc/codecs/bu26154.c b/sound/soc/codecs/bu26154.c
new file mode 100644
index 000000000..664c3c052
--- /dev/null
+++ b/sound/soc/codecs/bu26154.c
@@ -0,0 +1,542 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ROHM BU26154 mono audio codec (with touch controller) - ASoC driver
+ *
+ * Used in the SHARP Brain PW-Sx5 electronic dictionaries. Register layout
+ * from the ROHM datasheet (TSZ02201-0V2V0E500110-1-2, Rev.002):
+ *
+ *  - 8 bit registers, I2C address 0x1a
+ *  - every register is read at an even index and written at index + 1
+ *  - four register pages selected with MAPCON (read 0x1c / write 0x1d)
+ *
+ * The register "number" used by this driver is (page << 8) | read_index.
+ *
+ * Clocking follows the original firmware: the SoC provides MCLK = 512 fs
+ * (CLKSEL = 6, PLL unused) and is master of BCLK/LRCLK; data is 16 bit I2S.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#include "bu26154.h"
+
+#define BU_REG(page, idx)	(((page) << 8) | (idx))
+#define BU_PAGE(reg)		((reg) >> 8)
+#define BU_IDX(reg)		((reg) & 0xff)
+
+/* page 0 */
+#define BU_SR			BU_REG(0, 0x00)
+#define BU_CLKEN		BU_REG(0, 0x0c)
+#define   BU_CLKEN_MCLKEN	BIT(0)
+#define   BU_CLKEN_PLLEN	BIT(1)
+#define   BU_CLKEN_PLLOE	BIT(2)
+#define BU_CLKIO		BU_REG(0, 0x0e)
+#define   BU_CLKSEL_MCLK_512FS	0x6
+#define BU_SOFTRST		BU_REG(0, 0x10)
+#define BU_RECPLAY		BU_REG(0, 0x12)
+#define   BU_RECPLAY_REC	BIT(0)
+#define   BU_RECPLAY_PLAY	BIT(1)
+#define BU_MAPCON		0x1c
+#define BU_AREF_PM		BU_REG(0, 0x20)
+#define   BU_VMID_FAST		0x1
+#define   BU_VMID_NORMAL	0x2
+#define   BU_VMID_MASK		0x3
+#define   BU_MICBEN		BIT(2)
+#define   BU_HPVDDEN		BIT(3)
+#define   BU_HPLEN		BIT(6)
+#define   BU_HPREN		BIT(7)
+#define BU_AIN_PM		BU_REG(0, 0x22)
+#define   BU_ADCEN		BIT(1)
+#define   BU_ADCREN		BIT(2)
+#define   BU_PGAEN		BIT(3)
+#define BU_DAC_PM		BU_REG(0, 0x24)
+#define   BU_DACLEN		BIT(1)
+#define   BU_DACREN		BIT(2)
+#define BU_SPK_PM		BU_REG(0, 0x26)
+#define   BU_AVLEN		BIT(0)
+#define   BU_SPEN		BIT(1)
+#define   BU_SPK_FIXED		BIT(2)	/* "b02 is H fix" */
+#define   BU_AVREN		BIT(4)
+#define   BU_SPMDSEL_D		BIT(7)
+/* class D is selected once at probe: SPMDSEL may only change with SPEN = 0 */
+#define   BU_SPK_OFF		(BU_SPK_FIXED | BU_SPMDSEL_D)
+#define BU_TSD			BU_REG(0, 0x2c)
+#define BU_AVVOL		BU_REG(0, 0x3a)
+#define BU_PDATT		BU_REG(0, 0x3e)
+#define BU_AVCTL		BU_REG(0, 0x48)
+#define   BU_AVFADE		BIT(0)
+#define   BU_AVMUTE		BIT(1)
+#define BU_MICIF		BU_REG(0, 0x5a)
+#define BU_SAI_TX		BU_REG(0, 0x60)
+#define BU_SAI_RX		BU_REG(0, 0x62)
+#define   BU_SAI_PCM16		(0x2 << 6)
+#define BU_SAI_MODE		BU_REG(0, 0x64)
+#define   BU_SAI_MST		BIT(0)
+#define BU_DSPFILT		BU_REG(0, 0x66)
+#define BU_DVCTL		BU_REG(0, 0x68)
+#define   BU_DVFADE		BIT(3)
+#define   BU_DVMUTE		BIT(4)
+#define BU_MIXVOL		BU_REG(0, 0x6a)
+#define BU_RDVOL		BU_REG(0, 0x6c)
+#define BU_EQGAIN0		BU_REG(0, 0x74)
+
+/* page 1 */
+#define BU_HPIN			BU_REG(1, 0x82)
+#define BU_SPIN			BU_REG(1, 0x84)
+#define   BU_SPVOL_MASK		0x3
+#define   BU_SPIN1EN		BIT(2)
+#define   BU_SPIN2EN		BIT(3)
+
+struct bu26154 {
+	struct i2c_client *client;
+	struct mutex lock;		/* protects page and the I2C sequence */
+	struct mutex state_lock;	/* protects the stream/output state */
+	int page;			/* currently selected MAPCON page */
+	unsigned int rate_code;
+	bool play, rec;			/* streams that want to run */
+	unsigned int state;		/* RECPLAY value programmed */
+	bool spk_on, hp_on;		/* user selected outputs */
+};
+
+static const unsigned int bu_rates[] = {
+	8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000,
+};
+
+/* ---- register access ---------------------------------------------- */
+
+static int bu_select_page(struct bu26154 *bu, int page)
+{
+	int ret;
+
+	if (bu->page == page)
+		return 0;
+	ret = i2c_smbus_write_byte_data(bu->client, BU_MAPCON + 1, page);
+	bu->page = ret ? -1 : page;
+	return ret;
+}
+
+static unsigned int bu_read(struct snd_soc_component *component,
+			    unsigned int reg)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&bu->lock);
+	ret = bu_select_page(bu, BU_PAGE(reg));
+	if (!ret)
+		ret = i2c_smbus_read_byte_data(bu->client, BU_IDX(reg));
+	mutex_unlock(&bu->lock);
+
+	if (ret < 0) {
+		dev_err(component->dev, "read 0x%03x failed: %d\n", reg, ret);
+		return 0;
+	}
+	return ret;
+}
+
+static int bu_write(struct snd_soc_component *component, unsigned int reg,
+		    unsigned int val)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&bu->lock);
+	ret = bu_select_page(bu, BU_PAGE(reg));
+	if (!ret)
+		ret = i2c_smbus_write_byte_data(bu->client, BU_IDX(reg) + 1,
+						val & 0xff);
+	mutex_unlock(&bu->lock);
+
+	if (ret)
+		dev_err(component->dev, "write 0x%03x failed: %d\n", reg, ret);
+	return ret;
+}
+
+/* ---- power sequencing --------------------------------------------- */
+
+/*
+ * Bring the codec to the RECPLAY state wanted by the open streams.
+ * Transitions always pass through the stopped state as the datasheet
+ * requires, and the analog blocks follow the recommended sequences.
+ */
+static void bu_apply_state(struct snd_soc_component *c)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+	unsigned int want = (bu->play ? BU_RECPLAY_PLAY : 0) |
+			    (bu->rec ? BU_RECPLAY_REC : 0);
+	unsigned int aref, spk;
+
+	/* stop first: SR, SAI and power changes need RECPLAY = 0 */
+	if (bu->state) {
+		snd_soc_component_write(c, BU_RECPLAY, 0);
+		bu->state = 0;
+	}
+
+	if (!want) {
+		snd_soc_component_update_bits(c, BU_DVCTL, BU_DVMUTE,
+					      BU_DVMUTE);
+		snd_soc_component_write(c, BU_SPK_PM, BU_SPK_OFF);
+		snd_soc_component_update_bits(c, BU_AREF_PM,
+					      BU_HPLEN | BU_HPREN, 0);
+		snd_soc_component_write(c, BU_AREF_PM, 0);
+		snd_soc_component_write(c, BU_DAC_PM, 0);
+		snd_soc_component_write(c, BU_AIN_PM, 0);
+		snd_soc_component_write(c, BU_CLKEN, 0);
+		return;
+	}
+
+	/*
+	 * MCLK (512 fs) changes with the sample rate: the datasheet wants
+	 * PLLOE = 0 while it changes and PLLOE = 1 again afterwards.
+	 */
+	snd_soc_component_write(c, BU_CLKEN, BU_CLKEN_MCLKEN);
+	snd_soc_component_write(c, BU_SR, bu->rate_code);
+	snd_soc_component_write(c, BU_CLKEN, BU_CLKEN_MCLKEN | BU_CLKEN_PLLOE);
+
+	/* VMID: fast charge, then normal mode (min 5 ms each) */
+	aref = snd_soc_component_read(c, BU_AREF_PM);
+	if ((aref & BU_VMID_MASK) != BU_VMID_NORMAL) {
+		snd_soc_component_update_bits(c, BU_AREF_PM, BU_VMID_MASK,
+					      BU_VMID_FAST);
+		usleep_range(5000, 6000);
+		snd_soc_component_update_bits(c, BU_AREF_PM, BU_VMID_MASK,
+					      BU_VMID_NORMAL);
+		usleep_range(5000, 6000);
+	}
+
+	if (want & BU_RECPLAY_PLAY) {
+		snd_soc_component_write(c, BU_DAC_PM, BU_DACLEN | BU_DACREN);
+
+		spk = BU_SPK_OFF | BU_AVLEN | BU_AVREN;
+		if (bu->spk_on)
+			spk |= BU_SPEN;
+		snd_soc_component_write(c, BU_SPK_PM, spk);
+		snd_soc_component_update_bits(c, BU_SPIN, BU_SPIN1EN,
+					      bu->spk_on ? BU_SPIN1EN : 0);
+
+		if (bu->hp_on) {
+			/* headphone LDO first, amplifiers after >= 1 ms */
+			snd_soc_component_update_bits(c, BU_AREF_PM,
+						      BU_HPVDDEN, BU_HPVDDEN);
+			usleep_range(1000, 2000);
+			snd_soc_component_update_bits(c, BU_AREF_PM,
+						      BU_HPLEN | BU_HPREN,
+						      BU_HPLEN | BU_HPREN);
+		} else {
+			snd_soc_component_update_bits(c, BU_AREF_PM,
+					BU_HPLEN | BU_HPREN | BU_HPVDDEN, 0);
+		}
+
+		snd_soc_component_update_bits(c, BU_AVCTL, BU_AVMUTE, 0);
+	} else {
+		snd_soc_component_write(c, BU_SPK_PM, BU_SPK_OFF);
+		snd_soc_component_write(c, BU_DAC_PM, 0);
+	}
+
+	if (want & BU_RECPLAY_REC) {
+		snd_soc_component_update_bits(c, BU_AREF_PM, BU_MICBEN,
+					      BU_MICBEN);
+		snd_soc_component_write(c, BU_AIN_PM, BU_PGAEN | BU_ADCEN);
+	} else {
+		snd_soc_component_update_bits(c, BU_AREF_PM, BU_MICBEN, 0);
+		snd_soc_component_write(c, BU_AIN_PM, 0);
+	}
+
+	/* DVMUTE mutes the record volume too: release it for any stream */
+	snd_soc_component_update_bits(c, BU_DVCTL, BU_DVMUTE, 0);
+	snd_soc_component_write(c, BU_RECPLAY, want);
+	bu->state = want;
+}
+
+/* ---- controls ------------------------------------------------------ */
+
+/* 0x6f = mute, then 0.5 dB steps up to 0xff = 0 dB */
+static const DECLARE_TLV_DB_SCALE(pdatt_tlv, -7200, 50, 1);
+static const SNDRV_CTL_TLVD_DECLARE_DB_RANGE(avvol_tlv,
+	0x00, 0x00, SNDRV_CTL_TLVD_DB_SCALE_ITEM(-2800, 0, 1),
+	0x01, 0x06, SNDRV_CTL_TLVD_DB_SCALE_ITEM(-2800, 400, 0),
+	0x07, 0x0c, SNDRV_CTL_TLVD_DB_SCALE_ITEM(-600, 200, 0),
+	0x0d, 0x19, SNDRV_CTL_TLVD_DB_SCALE_ITEM(600, 100, 0),
+);
+static const DECLARE_TLV_DB_SCALE(spvol_tlv, 0, 600, 0);
+
+static int bu_output_get(struct snd_kcontrol *kc,
+			 struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kc);
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+
+	uc->value.integer.value[0] = kc->private_value ? bu->hp_on : bu->spk_on;
+	return 0;
+}
+
+static int bu_output_put(struct snd_kcontrol *kc,
+			 struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kc);
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+	bool on = !!uc->value.integer.value[0];
+	bool *flag = kc->private_value ? &bu->hp_on : &bu->spk_on;
+
+	mutex_lock(&bu->state_lock);
+	if (*flag == on) {
+		mutex_unlock(&bu->state_lock);
+		return 0;
+	}
+	*flag = on;
+	if (bu->play)
+		bu_apply_state(c);
+	mutex_unlock(&bu->state_lock);
+	return 1;
+}
+
+#define BU_OUTPUT_SWITCH(xname, hp) {				\
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = xname,	\
+	.info = snd_ctl_boolean_mono_info,			\
+	.get = bu_output_get, .put = bu_output_put,		\
+	.private_value = hp }
+
+static const struct snd_kcontrol_new bu_controls[] = {
+	SOC_SINGLE_RANGE_TLV("Playback Volume", BU_PDATT, 0, 0x6f, 0xff, 0,
+			     pdatt_tlv),
+	SOC_SINGLE_TLV("Output Volume", BU_AVVOL, 0, 0x19, 0, avvol_tlv),
+	SOC_SINGLE_TLV("Speaker Boost Volume", BU_SPIN, 0, 3, 0, spvol_tlv),
+	SOC_SINGLE_RANGE_TLV("Capture Volume", BU_RDVOL, 0, 0x6f, 0xff, 0,
+			     pdatt_tlv),
+	BU_OUTPUT_SWITCH("Speaker Switch", 0),
+	BU_OUTPUT_SWITCH("Headphone Switch", 1),
+};
+
+void bu26154_select_output(struct snd_soc_component *c, bool headphone)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+
+	mutex_lock(&bu->state_lock);
+	if (bu->hp_on != headphone || bu->spk_on == headphone) {
+		bu->hp_on = headphone;
+		bu->spk_on = !headphone;
+		if (bu->play)
+			bu_apply_state(c);
+	}
+	mutex_unlock(&bu->state_lock);
+	dev_dbg(c->dev, "output: %s\n", headphone ? "headphone" : "speaker");
+}
+EXPORT_SYMBOL_GPL(bu26154_select_output);
+
+/* ---- DAI ----------------------------------------------------------- */
+
+static int bu_hw_params(struct snd_pcm_substream *substream,
+			struct snd_pcm_hw_params *params,
+			struct snd_soc_dai *dai)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(dai->component);
+	unsigned int rate = params_rate(params);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(bu_rates); i++)
+		if (bu_rates[i] == rate)
+			break;
+	if (i == ARRAY_SIZE(bu_rates))
+		return -EINVAL;
+
+	/* playback and capture share one sample rate */
+	mutex_lock(&bu->state_lock);
+	if (bu->state && bu->rate_code != i) {
+		mutex_unlock(&bu->state_lock);
+		return -EBUSY;
+	}
+	bu->rate_code = i;
+	mutex_unlock(&bu->state_lock);
+	return 0;
+}
+
+static int bu_prepare(struct snd_pcm_substream *substream,
+		      struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *c = dai->component;
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+
+	mutex_lock(&bu->state_lock);
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		bu->play = true;
+	else
+		bu->rec = true;
+	bu_apply_state(c);
+	mutex_unlock(&bu->state_lock);
+	return 0;
+}
+
+static int bu_hw_free(struct snd_pcm_substream *substream,
+		      struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *c = dai->component;
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+	bool *flag = substream->stream == SNDRV_PCM_STREAM_PLAYBACK ?
+		     &bu->play : &bu->rec;
+
+	mutex_lock(&bu->state_lock);
+	if (*flag) {
+		*flag = false;
+		bu_apply_state(c);
+	}
+	mutex_unlock(&bu->state_lock);
+	return 0;
+}
+
+static int bu_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	/* only what the board uses: I2S, SoC is clock and frame master */
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S ||
+	    (fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF ||
+	    (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_CBC_CFC)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops bu_dai_ops = {
+	.hw_params	= bu_hw_params,
+	.prepare	= bu_prepare,
+	.hw_free	= bu_hw_free,
+	.set_fmt	= bu_set_fmt,
+};
+
+#define BU_RATES	SNDRV_PCM_RATE_8000_48000
+
+static struct snd_soc_dai_driver bu_dai = {
+	.name = "bu26154-hifi",
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 1,
+		.channels_max	= 2,
+		.rates		= BU_RATES,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name	= "Capture",
+		.channels_min	= 1,
+		.channels_max	= 2,
+		.rates		= BU_RATES,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &bu_dai_ops,
+	.symmetric_rate = 1,
+};
+
+/* ---- component ----------------------------------------------------- */
+
+static int bu_component_probe(struct snd_soc_component *c)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+
+	/* back to a known state: the boot firmware may have left anything */
+	snd_soc_component_write(c, BU_SOFTRST, 1);
+	snd_soc_component_write(c, BU_SOFTRST, 0);
+	bu->page = -1;
+
+	snd_soc_component_write(c, BU_RECPLAY, 0);
+	snd_soc_component_write(c, BU_CLKIO, BU_CLKSEL_MCLK_512FS);
+	snd_soc_component_write(c, BU_CLKEN, 0);
+	snd_soc_component_write(c, BU_TSD, 1);
+
+	/* 16 bit I2S both ways, codec is clock consumer */
+	snd_soc_component_write(c, BU_SAI_TX, BU_SAI_PCM16);
+	snd_soc_component_write(c, BU_SAI_RX, BU_SAI_PCM16);
+	snd_soc_component_write(c, BU_SAI_MODE, 0);
+
+	/* mono speaker on the L path: feed it (L+R)/2, R stays R */
+	snd_soc_component_write(c, BU_MIXVOL, 0x03);
+
+	/* firmware defaults: 0 dB analog, +12 dB speaker boost, HP both ch */
+	snd_soc_component_write(c, BU_AVVOL, 0x0a);
+	snd_soc_component_write(c, BU_PDATT, 0xff);
+	snd_soc_component_write(c, BU_SPIN, BU_SPIN1EN | 0x2);
+	snd_soc_component_write(c, BU_HPIN, 0x11);
+	snd_soc_component_write(c, BU_AVCTL, BU_AVMUTE);
+	snd_soc_component_write(c, BU_DVCTL, BU_DVMUTE);
+	/* SPEN is 0 after the reset: class D can be selected here */
+	snd_soc_component_write(c, BU_SPK_PM, BU_SPK_OFF);
+	return 0;
+}
+
+static void bu_component_remove(struct snd_soc_component *c)
+{
+	struct bu26154 *bu = snd_soc_component_get_drvdata(c);
+
+	mutex_lock(&bu->state_lock);
+	bu->play = bu->rec = false;
+	bu_apply_state(c);
+	mutex_unlock(&bu->state_lock);
+}
+
+static const struct snd_soc_component_driver bu_component = {
+	.probe			= bu_component_probe,
+	.remove			= bu_component_remove,
+	.read			= bu_read,
+	.write			= bu_write,
+	.controls		= bu_controls,
+	.num_controls		= ARRAY_SIZE(bu_controls),
+	.idle_bias_on		= 0,
+	.endianness		= 1,
+};
+
+static int bu26154_i2c_probe(struct i2c_client *client)
+{
+	struct bu26154 *bu;
+	int ret;
+
+	bu = devm_kzalloc(&client->dev, sizeof(*bu), GFP_KERNEL);
+	if (!bu)
+		return -ENOMEM;
+	bu->client = client;
+	bu->page = -1;
+	bu->spk_on = true;
+	bu->rate_code = 7;	/* 44.1 kHz */
+	mutex_init(&bu->lock);
+	mutex_init(&bu->state_lock);
+	i2c_set_clientdata(client, bu);
+
+	/* identify: page 0 must be selectable and EQ band 0 gain readable */
+	ret = i2c_smbus_write_byte_data(client, BU_MAPCON + 1, 0);
+	if (!ret)
+		ret = i2c_smbus_read_byte_data(client, BU_MAPCON);
+	if (ret != 0) {
+		dev_err(&client->dev, "BU26154 not responding (%d)\n", ret);
+		return ret < 0 ? ret : -ENODEV;
+	}
+	bu->page = 0;
+
+	return devm_snd_soc_register_component(&client->dev, &bu_component,
+					       &bu_dai, 1);
+}
+
+static const struct of_device_id bu26154_of_match[] = {
+	{ .compatible = "rohm,bu26154" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bu26154_of_match);
+
+static const struct i2c_device_id bu26154_i2c_id[] = {
+	{ "bu26154", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, bu26154_i2c_id);
+
+static struct i2c_driver bu26154_i2c_driver = {
+	.driver = {
+		.name = "bu26154",
+		.of_match_table = bu26154_of_match,
+	},
+	.probe_new = bu26154_i2c_probe,
+	.id_table = bu26154_i2c_id,
+};
+module_i2c_driver(bu26154_i2c_driver);
+
+MODULE_DESCRIPTION("ROHM BU26154 audio codec driver");
+MODULE_LICENSE("GPL");
