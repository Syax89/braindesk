+/*
+ * Point the panel's write window at rows [y0, y1); the column window set in
+ * brain_enable() (full width) stays as it is.
+ *
+ * Commands are written through LCDC_DATA, which the LCDIF only uses while it
+ * is NOT a bus master: with CTRL_MASTER set it would fetch the "command"
+ * from the frame buffer instead and the panel would stop accepting pixels.
+ * So drop to PIO and 8 bit packaging like brain_enable() does, then go back.
+ */
+static void brain_set_rows(struct brain_drm_private *ili, u16 y0, u16 y1)
+{
+	u32 valid = CTRL1_GET_BYTE_PACKAGING(readl(ili->base + LCDC_CTRL1));
+	u16 ye = y1 - 1;
+
+	writel(CTRL_MASTER, ili->base + LCDC_CTRL + REG_CLR);
+	writel(CTRL1_SET_BYTE_PACKAGING(0xf), ili->base + LCDC_CTRL1 + REG_CLR);
+	writel(CTRL1_SET_BYTE_PACKAGING(0x3), ili->base + LCDC_CTRL1 + REG_SET);
+
+	brain_write_byte(ili, 0x2b, 0);		/* Page Address Set */
+	brain_write_byte(ili, y0 >> 8, 1);
+	brain_write_byte(ili, y0 & 0xff, 1);
+	brain_write_byte(ili, ye >> 8, 1);
+	brain_write_byte(ili, ye & 0xff, 1);
+	brain_write_byte(ili, 0x2c, 0);		/* Memory Write */
+
+	writel(CTRL1_SET_BYTE_PACKAGING(0xf), ili->base + LCDC_CTRL1 + REG_CLR);
+	writel(CTRL1_SET_BYTE_PACKAGING(valid), ili->base + LCDC_CTRL1 + REG_SET);
+	writel(CTRL_MASTER, ili->base + LCDC_CTRL + REG_SET);
