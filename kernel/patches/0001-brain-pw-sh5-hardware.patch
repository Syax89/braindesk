diff --git a/sound/soc/mxs/mxs-brain.c b/sound/soc/mxs/mxs-brain.c
new file mode 100644
index 000000000..8bc807df6
--- /dev/null
+++ b/sound/soc/mxs/mxs-brain.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * ASoC machine driver for SHARP Brain (i.MX28 SAIF + ROHM BU26154)
+ *
+ * Based on mxs-sgtl5000.c. SAIF0 drives playback and is clock master,
+ * SAIF1 captures as its slave; SAIF0 MCLK feeds the codec at 512 fs.
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/jack.h>
+#include <sound/soc.h>
+
+#include "../codecs/bu26154.h"
+#include "mxs-saif.h"
+
+static int mxs_brain_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = asoc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = asoc_rtd_to_cpu(rtd, 0);
+	u32 mclk = 512 * params_rate(params);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, MXS_SAIF_MCLK, mclk, 0);
+	if (ret)
+		dev_err(cpu_dai->dev, "failed to set MCLK to %u Hz\n", mclk);
+	return ret;
+}
+
+static const struct snd_soc_ops mxs_brain_ops = {
+	.hw_params = mxs_brain_hw_params,
+};
+
+#define MXS_BRAIN_DAI_FMT (SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | \
+			   SND_SOC_DAIFMT_CBC_CFC)
+
+SND_SOC_DAILINK_DEFS(brain_tx,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "bu26154-hifi")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(brain_rx,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "bu26154-hifi")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link mxs_brain_dai[] = {
+	{
+		.name		= "BU26154 Tx",
+		.stream_name	= "Playback",
+		.dai_fmt	= MXS_BRAIN_DAI_FMT,
+		.ops		= &mxs_brain_ops,
+		.playback_only	= true,
+		SND_SOC_DAILINK_REG(brain_tx),
+	}, {
+		.name		= "BU26154 Rx",
+		.stream_name	= "Capture",
+		.dai_fmt	= MXS_BRAIN_DAI_FMT,
+		.ops		= &mxs_brain_ops,
+		.capture_only	= true,
+		SND_SOC_DAILINK_REG(brain_rx),
+	},
+};
+
+/*
+ * Optional headphone detection: with "hp-det-gpios" in the device tree the
+ * card gets a "Headphone Jack" and playback moves between the speaker and
+ * the headphones automatically.
+ */
+static struct snd_soc_jack hp_jack;
+static struct snd_soc_jack_gpio hp_jack_gpio = {
+	.name = "hp-det",
+	.report = SND_JACK_HEADPHONE,
+	.debounce_time = 200,
+};
+static struct snd_soc_component *brain_codec;
+
+static int mxs_brain_jack_event(struct notifier_block *nb, unsigned long event,
+				void *data)
+{
+	if (brain_codec)
+		bu26154_select_output(brain_codec, event & SND_JACK_HEADPHONE);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block mxs_brain_jack_nb = {
+	.notifier_call = mxs_brain_jack_event,
+};
+
+static int mxs_brain_late_probe(struct snd_soc_card *card)
+{
+	struct snd_soc_pcm_runtime *rtd;
+	int ret;
+
+	rtd = snd_soc_get_pcm_runtime(card, &card->dai_link[0]);
+	if (!rtd)
+		return -EINVAL;
+	brain_codec = asoc_rtd_to_codec(rtd, 0)->component;
+
+	ret = snd_soc_card_jack_new(card, "Headphone Jack", SND_JACK_HEADPHONE,
+				    &hp_jack);
+	if (ret)
+		return ret;
+	snd_soc_jack_notifier_register(&hp_jack, &mxs_brain_jack_nb);
+
+	hp_jack_gpio.gpiod_dev = card->dev;
+	ret = snd_soc_jack_add_gpios(&hp_jack, 1, &hp_jack_gpio);
+	if (ret)
+		dev_warn(card->dev, "headphone detection disabled: %d\n", ret);
+	return 0;
+}
+
+static struct snd_soc_card mxs_brain_card = {
+	.name		= "Brain",
+	.owner		= THIS_MODULE,
+	.dai_link	= mxs_brain_dai,
+	.num_links	= ARRAY_SIZE(mxs_brain_dai),
+};
+
+static int mxs_brain_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct snd_soc_card *card = &mxs_brain_card;
+	struct device_node *saif_np[2], *codec_np;
+	int ret, i;
+
+	saif_np[0] = of_parse_phandle(np, "saif-controllers", 0);
+	saif_np[1] = of_parse_phandle(np, "saif-controllers", 1);
+	codec_np = of_parse_phandle(np, "audio-codec", 0);
+	if (!saif_np[0] || !saif_np[1] || !codec_np) {
+		dev_err(&pdev->dev, "phandle missing or invalid\n");
+		ret = -EINVAL;
+		goto out_put;
+	}
+
+	for (i = 0; i < 2; i++) {
+		mxs_brain_dai[i].codecs->name = NULL;
+		mxs_brain_dai[i].codecs->of_node = codec_np;
+		mxs_brain_dai[i].cpus->dai_name = NULL;
+		mxs_brain_dai[i].cpus->of_node = saif_np[i];
+		mxs_brain_dai[i].platforms->name = NULL;
+		mxs_brain_dai[i].platforms->of_node = saif_np[i];
+	}
+
+	of_property_read_string(np, "model", &card->name);
+	if (of_find_property(np, "hp-det-gpios", NULL))
+		card->late_probe = mxs_brain_late_probe;
+
+	/* keep MCLK running so the codec always has a clock */
+	ret = mxs_saif_get_mclk(0, 44100 * 512, 44100);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to get mclk\n");
+		goto out_put;
+	}
+
+	card->dev = &pdev->dev;
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		mxs_saif_put_mclk(0);
+		dev_err_probe(&pdev->dev, ret, "failed to register card\n");
+	}
+
+out_put:
+	of_node_put(codec_np);
+	of_node_put(saif_np[0]);
+	of_node_put(saif_np[1]);
+	return ret;
+}
+
+static int mxs_brain_remove(struct platform_device *pdev)
+{
+	if (hp_jack_gpio.desc)
+		snd_soc_jack_free_gpios(&hp_jack, 1, &hp_jack_gpio);
+	brain_codec = NULL;
+	mxs_saif_put_mclk(0);
+	return 0;
+}
+
+static const struct of_device_id mxs_brain_dt_ids[] = {
+	{ .compatible = "sharp,brain-audio-bu26154", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mxs_brain_dt_ids);
+
+static struct platform_driver mxs_brain_audio_driver = {
+	.driver = {
+		.name = "mxs-brain-audio",
+		.of_match_table = mxs_brain_dt_ids,
+	},
+	.probe = mxs_brain_probe,
+	.remove = mxs_brain_remove,
+};
+module_platform_driver(mxs_brain_audio_driver);
+
+MODULE_DESCRIPTION("SHARP Brain ALSA SoC machine driver");
+MODULE_LICENSE("GPL");
