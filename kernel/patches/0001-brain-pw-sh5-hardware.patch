+/*
+ * Panel orientation. The ILI9805 is natively portrait (480x854) and the
+ * device tree turns it landscape with MADCTL.MV; rotation flips that in the
+ * panel controller itself, so a rotated desktop costs no CPU or PXP time.
+ *   0 = as described by the device tree (landscape on the PW-Sx series)
+ *   1 = portrait
+ *   2 = portrait, upside down
+ * The device tree property "sharp,rotation" sets it at boot; a non-zero
+ * module parameter (brain.rotation=N) overrides it.
+ */
+static unsigned int rotation;
+module_param(rotation, uint, 0644);
+MODULE_PARM_DESC(rotation, "0=landscape (DT), 1=portrait, 2=portrait inverted");
+
+/* Diagnostics, changeable at run time in /sys/module/brain/parameters */
+static bool partial = true;
+module_param(partial, bool, 0644);
+MODULE_PARM_DESC(partial, "send only the damaged rows (0 = always full frames)");
+
+static unsigned int bus_timing = 1;
+module_param(bus_timing, uint, 0644);
+MODULE_PARM_DESC(bus_timing, "LCDIF setup/hold in clock cycles (1..15)");
+
+static bool brain_rotated(void)
+{
+	return rotation == 1 || rotation == 2;
+}
+
+static void brain_panel_dims(struct device_node *np, u32 *w, u32 *h,
+			     u32 *wmm, u32 *hmm)
+{
+	u32 a = 0, b = 0, amm = 0, bmm = 0;
+
+	of_property_read_u32(np, "sharp,lcd-width", &a);
+	of_property_read_u32(np, "sharp,lcd-height", &b);
+	of_property_read_u32(np, "sharp,lcd-width-mm", &amm);
+	of_property_read_u32(np, "sharp,lcd-height-mm", &bmm);
+	if (brain_rotated()) {
+		swap(a, b);
+		swap(amm, bmm);
+	}
+	*w = a;
+	*h = b;
+	if (wmm)
+		*wmm = amm;
+	if (hmm)
+		*hmm = bmm;
+}
