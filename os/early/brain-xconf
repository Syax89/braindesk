#!/bin/sh
# brain-xconf: scrive /etc/X11/brain-run.conf, la configurazione del server
# X per il pannello, il tocco e la tastiera del Brain. E' la stessa che
# genera brain-ui (stessi dispositivi trovati per nome, stessa calibrazione,
# stessa matrice di rotazione): qui a parte perche' senza X all'avvio serve
# solo quando un'app esterna chiede X (brain-xapp). Gira come root.
# In piu' rispetto a brain-ui: "GrabDevice" "false" (gia' il default del
# driver evdev, qui esplicito): durante l'app brainshell deve continuare a
# leggere tasti (Home, Ctrl+Alt+Esc, accensione) e tocchi (inattivita').
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ev() {
	for e in /sys/class/input/event*; do
		[ "$(cat "$e/device/name" 2>/dev/null)" = "$1" ] && { echo "/dev/input/${e##*/}"; return; }
	done
}
ts=$(ev mxs-lradc-ts); kb=$(ev brain-kbd-gpio)
cal=$(sed -n 's/.*"Calibration"[[:space:]]*"\(.*\)".*/\1/p' /etc/X11/xorg.conf.d/99-calibrator.conf 2>/dev/null | head -1)
case "$(cat /etc/brain-rotation 2>/dev/null)" in
	1) m="0 -1 1 1 0 0 0 0 1" ;;
	2) m="0 1 0 -1 0 1 0 0 1" ;;
	*) m="1 0 0 0 1 0 0 0 1" ;;
esac
conf=/etc/X11/brain-run.conf
{
	cat /etc/X11/brain-xorg.conf
	echo 'Section "ServerLayout"'
	echo '	Identifier "brain"'
	echo '	Screen "screen"'
	[ -n "$ts" ] && echo '	InputDevice "touch" "CorePointer"'
	[ -n "$kb" ] && echo '	InputDevice "tasti" "CoreKeyboard"'
	echo 'EndSection'
	[ -n "$ts" ] && cat <<EOC
Section "InputDevice"
	Identifier "touch"
	Driver "evdev"
	Option "Device" "$ts"
	Option "GrabDevice" "false"
	${cal:+Option \"Calibration\" \"$cal\"}
	Option "TransformationMatrix" "$m"
EndSection
EOC
	[ -n "$kb" ] && cat <<EOC
Section "InputDevice"
	Identifier "tasti"
	Driver "evdev"
	Option "Device" "$kb"
	Option "GrabDevice" "false"
	Option "XkbLayout" "us"
EndSection
EOC
} > "$conf.tmp" && mv "$conf.tmp" "$conf"
