#!/bin/sh
# brain-zram: swap compresso in RAM (64 MB, lzo-rle) al posto del file di
# swap sulla microSD: piu' memoria utile senza attese di lettura/scrittura.
[ -e /sys/block/zram0 ] || exit 0
grep -q zram0 /proc/swaps && exit 0
echo lzo-rle > /sys/block/zram0/comp_algorithm 2>/dev/null
echo 64M > /sys/block/zram0/disksize || exit 0
mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
echo 100 > /proc/sys/vm/swappiness
echo 0 > /proc/sys/vm/page-cluster
